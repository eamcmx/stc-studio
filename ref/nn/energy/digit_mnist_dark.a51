; DISPLAY OFF BUILD (nn/energy_build.py): ref/nn/mnist/digit_mnist.a51 without the display interrupt.
; MNIST digit reader: 14 x 14 binary images (2 x 2 mean >= 96), a 196-32-10 network on the STC89C52RC.
; Written by nn/train_mnist.py with nn/gen51.py from ref/nn/digit_nn.a51; the inputs are kept as bits.
; The page sends D and 196 characters, 1 or 0, row by row from the top left; the board answers "=", the
; digit and its 10 scores in hex, and shows the digit. Serial: 19200 baud. Do not edit by hand.

PIX     EQU     30H             ; 25 bytes: the inputs, 8 to a byte, first input in bit 7 (30H-48H)
ACC1    EQU     049H            ; NH x 16-bit sums of the hidden layer    (49H-88H)
HID     EQU     ACC1+2*NH       ; NH hidden values, 0 to 255               (89H-A8H; above 7FH only @R0/@R1 reach)
SCORE   EQU     HID+NH          ; 10 x 24-bit scores, low byte first       (A9H-C6H)
DBUF    EQU     2CH             ; 4 segment patterns, digit 1 to digit 4
DIGI    EQU     2BH             ; the digit the display is showing now (0-3)

        ORG     0000H
        LJMP    MAIN
        ORG     000BH
        LJMP    T0ISR

        ORG     0030H
MAIN:   MOV     SP,#0C7H        ; stack from C8H
        MOV     DBUF,#0ABH      ; "nn--" until the first digit arrives
        MOV     DBUF+1,#0ABH
        MOV     DBUF+2,#0BFH
        MOV     DBUF+3,#0BFH
        MOV     DIGI,#0
        MOV     TMOD,#22H       ; Timer 1: baud rate, Timer 0: display, both 8-bit auto-reload
        MOV     TH1,#0FDH
        MOV     TL1,#0FDH
        ORL     PCON,#80H       ; SMOD = 1: 19200 baud
        MOV     SCON,#50H       ; mode 1, receiver on
        MOV     TH0,#0          ; Timer 0 overflows every 256 machine cycles
        MOV     TL0,#0
        SETB    TR1
        SETB    TR0
        NOP                     ; DISPLAY OFF BUILD (no SETB ET0)
        NOP
        SETB    EA
        MOV     DPTR,#HELLO
        ACALL   PUTS

; ---- wait for D, then read 35 pixels
WAITD:  ACALL   GETC
        CJNE    A,#'D',WAITD
        MOV     R0,#PIX
        MOV     R3,#NIN
        MOV     R2,#8           ; bits left in the byte being filled
RDPIX:  ACALL   GETC
        CJNE    A,#'1',RDBIT    ; C = 1 for '0' (below '1'), 0 for '1'
RDBIT:  CPL     C               ; the input as a bit
        MOV     A,R7
        RLC     A               ; into the byte, first input ends in bit 7
        MOV     R7,A
        DJNZ    R2,RDNEXT
        MOV     @R0,A           ; 8 inputs: store the byte
        INC     R0
        MOV     R2,#8
RDNEXT: DJNZ    R3,RDPIX
        CJNE    R2,#8,RDLAST    ; inputs left over in a part-filled byte?
        SJMP    RDDONE
RDLAST: MOV     A,R7
RDALGN: CLR     C               ; shift them up to bit 7
        RLC     A
        DJNZ    R2,RDALGN
        MOV     @R0,A
RDDONE:

; ---- layer 1: start every sum at its bias
        MOV     DPTR,#B1
        MOV     R0,#ACC1
        MOV     R2,#2*NH
L1B:    CLR     A
        MOVC    A,@A+DPTR
        MOV     @R0,A
        INC     DPTR
        INC     R0
        DJNZ    R2,L1B
; for every lit input (a 1 bit), add its row of NH weights to the NH sums
        MOV     DPTR,#W1
        MOV     R1,#PIX
        MOV     R3,#NIN
        MOV     R2,#1           ; a new byte at the first input
L1P:    DJNZ    R2,L1BIT
        MOV     A,@R1           ; the next 8 inputs
        INC     R1
        MOV     R7,A
        MOV     R2,#8
L1BIT:  MOV     A,R7
        RLC     A               ; the input to C
        MOV     R7,A
        JNC     L1NEXT
        MOV     R0,#ACC1
        MOV     R4,#0
L1J:    MOV     A,R4
        MOVC    A,@A+DPTR       ; the weight, -128 to 127
        MOV     R5,A
        ADD     A,@R0           ; low byte of the sum
        MOV     @R0,A
        INC     R0
        MOV     A,R5
        JB      ACC.7,L1NEG
        CLR     A               ; a positive weight adds 00H to the high byte, with the carry
        SJMP    L1HI
L1NEG:  MOV     A,#0FFH         ; a negative one adds FFH
L1HI:   ADDC    A,@R0
        MOV     @R0,A
        INC     R0
        INC     R4
        CJNE    R4,#NH,L1J
L1NEXT: MOV     A,DPL           ; on to the next input's row
        ADD     A,#NH
        MOV     DPL,A
        JNC     L1N2
        INC     DPH
L1N2:   DJNZ    R3,L1P

; ---- ReLU and scaling: hidden = 0 for a negative sum, else sum >> SH1, at most 255
        MOV     R0,#ACC1
        MOV     R1,#HID
        MOV     R2,#NH
RL1:    MOV     A,@R0
        MOV     R6,A            ; low byte
        INC     R0
        MOV     A,@R0
        MOV     R7,A            ; high byte
        INC     R0
        JB      ACC.7,RZERO
        MOV     R5,#SH1
RSH:    MOV     A,R5
        JZ      RSAT
        CLR     C
        MOV     A,R7
        RRC     A
        MOV     R7,A
        MOV     A,R6
        RRC     A
        MOV     R6,A
        DEC     R5
        SJMP    RSH
RSAT:   MOV     A,R7
        JZ      RLOW
        MOV     A,#0FFH         ; too big for a byte: 255
        SJMP    RSTORE
RLOW:   MOV     A,R6
        SJMP    RSTORE
RZERO:  CLR     A
RSTORE: MOV     @R1,A
        INC     R1
        DJNZ    R2,RL1

; ---- layer 2: score k = bias + sum of hidden j * weight, 24 bits in R7:R6:R5
        MOV     DPTR,#W2        ; each row: 3 bytes of bias, then NH weights
        MOV     R1,#SCORE
        MOV     R3,#10
L2K:    CLR     A
        MOVC    A,@A+DPTR
        MOV     R5,A
        MOV     A,#1
        MOVC    A,@A+DPTR
        MOV     R6,A
        MOV     A,#2
        MOVC    A,@A+DPTR
        MOV     R7,A
        MOV     R0,#HID
        MOV     R2,#3
L2J:    MOV     A,R2
        MOVC    A,@A+DPTR       ; the weight
        JB      ACC.7,L2NEG
        MOV     B,@R0
        MUL     AB              ; hidden * weight: B = high byte, A = low byte
        ADD     A,R5
        MOV     R5,A
        MOV     A,B
        ADDC    A,R6
        MOV     R6,A
        CLR     A
        ADDC    A,R7
        MOV     R7,A
        SJMP    L2NEXT
L2NEG:  CPL     A               ; a negative weight: multiply by its size and subtract
        INC     A
        MOV     B,@R0
        MUL     AB
        XCH     A,R5            ; A = the score's low byte, R5 = the product's low byte
        CLR     C
        SUBB    A,R5
        MOV     R5,A
        MOV     A,R6
        SUBB    A,B
        MOV     R6,A
        MOV     A,R7
        SUBB    A,#0
        MOV     R7,A
L2NEXT: INC     R0
        INC     R2
        CJNE    R2,#NH+3,L2J
        MOV     A,R5            ; keep the score
        MOV     @R1,A
        INC     R1
        MOV     A,R6
        MOV     @R1,A
        INC     R1
        MOV     A,R7
        MOV     @R1,A
        INC     R1
        MOV     A,DPL           ; on to the next digit's row
        ADD     A,#NH+3
        MOV     DPL,A
        JNC     L2N2
        INC     DPH
L2N2:   DJNZ    R3,L2K

; ---- the largest score: compare with the sign bit flipped, so that unsigned order is signed order
        MOV     R1,#SCORE
        MOV     A,@R1
        MOV     R5,A
        INC     R1
        MOV     A,@R1
        MOV     R6,A
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     R7,A            ; R7:R6:R5 = the best so far
        INC     R1
        MOV     R4,#0           ; its digit
        MOV     R3,#1
AMAX:   CLR     C               ; best - score: a borrow means this score is larger
        MOV     A,R5
        SUBB    A,@R1
        INC     R1
        MOV     A,R6
        SUBB    A,@R1
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     B,A
        MOV     A,R7
        SUBB    A,B
        JNC     AMNEXT
        DEC     R1              ; a new best
        DEC     R1
        MOV     A,@R1
        MOV     R5,A
        INC     R1
        MOV     A,@R1
        MOV     R6,A
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     R7,A
        MOV     A,R3
        MOV     R4,A
AMNEXT: INC     R1
        INC     R3
        CJNE    R3,#10,AMAX

; ---- show it ("nn 7") and send "=7" and the 10 scores
        MOV     A,R4
        MOV     DPTR,#SEGS
        MOVC    A,@A+DPTR
        MOV     DBUF+3,A
        MOV     DBUF+2,#0FFH
        MOV     A,#'='
        ACALL   PUTC
        MOV     A,R4
        ADD     A,#'0'
        ACALL   PUTC
        MOV     R1,#SCORE+2     ; the high byte of score 0
        MOV     R3,#10
SEND:   MOV     A,#' '
        ACALL   PUTC
        MOV     A,@R1
        ACALL   PUTHEX
        DEC     R1
        MOV     A,@R1
        ACALL   PUTHEX
        DEC     R1
        MOV     A,@R1
        ACALL   PUTHEX
        MOV     A,R1
        ADD     A,#5            ; the high byte of the next score
        MOV     R1,A
        DJNZ    R3,SEND
        MOV     A,#13
        ACALL   PUTC
        MOV     A,#10
        ACALL   PUTC
        LJMP    WAITD

; ---- serial port
GETC:   JNB     RI,GETC
        MOV     A,SBUF
        CLR     RI
        RET
PUTC:   MOV     SBUF,A
        JNB     TI,$
        CLR     TI
        RET
PUTHEX: PUSH    ACC             ; two hex characters for A
        SWAP    A
        ACALL   NIBBLE
        POP     ACC
NIBBLE: ANL     A,#0FH
        CJNE    A,#10,NIB1
NIB1:   JC      NIB2            ; 0-9
        ADD     A,#7            ; A-F
NIB2:   ADD     A,#'0'
        ACALL   PUTC
        RET
PUTS:   CLR     A               ; the text at DPTR, up to a 0 byte
        MOVC    A,@A+DPTR
        JZ      PUTS9
        ACALL   PUTC
        INC     DPTR
        SJMP    PUTS
PUTS9:  RET

; ---- Timer 0, every 256 machine cycles: the next digit of the display (register bank 1)
T0ISR:  PUSH    PSW
        PUSH    ACC
        PUSH    DPL
        PUSH    DPH
        MOV     PSW,#08H
        MOV     P1,#0FFH        ; all digits off while the segments change
        MOV     A,DIGI
        INC     A
        ANL     A,#03H
        MOV     DIGI,A
        ADD     A,#DBUF
        MOV     R0,A
        MOV     P0,@R0
        MOV     A,DIGI
        MOV     DPTR,#DSEL
        MOVC    A,@A+DPTR
        MOV     P1,A
        POP     DPH
        POP     DPL
        POP     ACC
        POP     PSW
        RETI

DSEL:   DB      0F7H,0EFH,0DFH,0BFH            ; digit 1 to digit 4: P1.3 to P1.6 low
SEGS:   DB      0C0H,0F9H,0A4H,0B0H,99H,92H,82H,0F8H,80H,90H
HELLO:  DB      'NN READY',13,10,0

; ---- WEIGHTS (written by nn/gen51.py)
NIN     EQU     196              ; inputs
NH      EQU     32              ; hidden neurons
SH1     EQU     1               ; hidden values are (sum >> SH1), 0 to 255

B1:
        DB      0F1H,0FFH,019H,000H,0E9H,0FFH,01EH,000H,0B7H,0FFH,0FAH,0FFH,0FCH,0FFH,014H,000H
        DB      02CH,000H,0DAH,0FFH,0CCH,0FFH,022H,000H,0FAH,0FFH,0FDH,0FFH,0E1H,0FFH,030H,000H
        DB      01DH,000H,0E0H,0FFH,0CAH,0FFH,001H,000H,000H,000H,02BH,000H,00EH,000H,0EBH,0FFH
        DB      0FDH,0FFH,0F7H,0FFH,035H,000H,002H,000H,026H,000H,033H,000H,01FH,000H,0ECH,0FFH
W1:
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,0FFH,005H,000H,000H,000H,000H,000H,0FAH,000H,000H,000H,000H,005H
        DB      000H,0FBH,000H,001H,008H,000H,0FFH,000H,000H,000H,0FFH,0F8H,000H,003H,0FFH,001H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      002H,001H,008H,000H,0FCH,0FCH,000H,003H,0FFH,000H,003H,002H,000H,0F9H,000H,000H
        DB      000H,000H,0FFH,000H,0FDH,0FEH,006H,002H,000H,0FBH,0FFH,000H,0FEH,000H,00EH,0FEH
        DB      00CH,0FBH,002H,0FFH,002H,005H,000H,000H,0F7H,002H,001H,0FFH,000H,0EBH,000H,005H
        DB      0FEH,000H,0F7H,000H,006H,0FDH,00FH,0FDH,000H,0F8H,002H,0F9H,00AH,0FDH,022H,0FEH
        DB      017H,0FFH,005H,0FFH,006H,007H,000H,0FDH,0F5H,008H,013H,0F6H,000H,0FCH,0F5H,005H
        DB      0F9H,0F8H,0FAH,000H,006H,0F8H,005H,0EEH,000H,002H,00BH,0E6H,018H,0EBH,011H,0F5H
        DB      004H,0FCH,009H,00BH,00AH,0FFH,000H,0F9H,0E9H,005H,002H,006H,000H,0EFH,0F8H,0F4H
        DB      003H,0F9H,0E8H,005H,004H,0F0H,0F0H,0F9H,000H,0FAH,0FCH,0FAH,023H,0EDH,016H,0FDH
        DB      0F6H,008H,0FEH,004H,00BH,0FEH,000H,0FEH,0FAH,0ECH,011H,0FCH,000H,0F2H,0F5H,000H
        DB      0FBH,007H,0FAH,0F9H,0F2H,0F9H,0D5H,01DH,000H,002H,0EEH,0FDH,018H,0F0H,025H,0FDH
        DB      0F0H,006H,0F7H,0E6H,009H,000H,000H,007H,0FFH,0F7H,008H,000H,000H,0F8H,0FDH,0FBH
        DB      003H,004H,00DH,0FEH,0F4H,0F8H,0E3H,012H,000H,0F5H,0FBH,010H,017H,0F3H,00EH,0FFH
        DB      0FBH,0FFH,0EFH,0EDH,0DDH,001H,000H,0FFH,003H,003H,008H,0F5H,000H,0F8H,007H,0FAH
        DB      0FCH,019H,001H,0FEH,0F5H,004H,001H,00DH,000H,001H,0F3H,00EH,00BH,0F6H,022H,0FAH
        DB      0FCH,0FDH,002H,0FDH,0E7H,0F6H,000H,0F9H,0FBH,006H,0FFH,0F9H,000H,00AH,008H,0F8H
        DB      000H,006H,0F6H,002H,001H,000H,01DH,005H,000H,009H,001H,00CH,0FAH,0F8H,014H,008H
        DB      000H,001H,0FFH,005H,001H,0FCH,000H,0FFH,0F8H,0FEH,001H,0FEH,000H,0FFH,007H,0FEH
        DB      0FEH,000H,000H,002H,0FBH,000H,00CH,008H,000H,001H,0FCH,007H,0FDH,0F6H,009H,006H
        DB      000H,000H,000H,002H,001H,000H,000H,000H,000H,0FFH,000H,000H,000H,000H,002H,000H
        DB      000H,0FFH,000H,001H,000H,000H,003H,002H,000H,000H,000H,001H,000H,0FDH,000H,001H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      004H,0FDH,004H,003H,007H,0F8H,000H,007H,002H,002H,009H,004H,000H,004H,0FFH,0FCH
        DB      001H,000H,000H,0FBH,00AH,0FCH,003H,001H,000H,0FBH,0FDH,003H,002H,000H,0FBH,0F9H
        DB      000H,0F8H,002H,011H,003H,005H,000H,00BH,0F8H,00BH,00BH,0FEH,000H,008H,0FEH,008H
        DB      0FDH,0F8H,001H,0F3H,01BH,0FDH,007H,0F9H,000H,0E9H,00BH,0E7H,0F8H,0FAH,00FH,0EAH
        DB      001H,0FBH,000H,003H,0FEH,0F3H,000H,003H,0E6H,01BH,01CH,0E8H,000H,007H,008H,00BH
        DB      0E1H,0F7H,0F7H,0EEH,004H,0FAH,01BH,0ECH,000H,009H,00AH,0F5H,010H,0F2H,00EH,0F2H
