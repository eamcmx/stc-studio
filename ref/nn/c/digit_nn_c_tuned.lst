   1          /* digit_nn.c: the digit reader in C for Keil C51, to compare with the hand-written ref/nn/digit_nn.a51.
   2           *
   3           * The same network (35 -> NH hidden with ReLU -> 10), the same 8-bit weights (weights.h, made by
   4           * nn/train_digits.py), the same serial protocol (D + 35 characters in, "=7" + 10 scores in hex out, 19200
             - baud)
   5           * and the same display ("nn 7", refreshed by Timer 0). Written the way a careful 8051 C programmer would:
   6           * byte-sized loop counters, arrays in idata, layer 1 as additions only, and a 16-bit product in layer 2
   7           * (255 * 127 fits in an int). Two other builds for the comparison in docs/m6-c-vs-asm.md:
   8           *   DEFINE(LONGMUL)  multiply in 32 bits, as plain C would
   9           *   DEFINE(TUNED)    C written for the 8051: pointers through the tables, 8 x 8 unsigned products (MUL AB
             -)
  10           */
  11          #include <reg52.h>
  12          #include "weights.h"
  13          
  14          unsigned char idata pix[35];      /* the drawing, 0 or 1 */
  15          int idata acc[NH];                /* layer 1 sums */
  16          unsigned char idata hid[NH];      /* hidden values, 0 to 255 */
  17          long idata score[10];             /* layer 2 sums, one per digit */
  18          unsigned char data dbuf[4];       /* segment patterns for digits 1 to 4 */
  19          unsigned char data digi;          /* the digit the display shows now */
  20          
  21          unsigned char code dsel[4] = { 0xF7, 0xEF, 0xDF, 0xBF };   /* P1.3 to P1.6 low */
  22          unsigned char code segs[10] = { 0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90 };
  23          char code hexd[] = "0123456789ABCDEF";
  24          
  25          /* Timer 0, every 256 machine cycles: the next digit of the display (register bank 1, like the assembly) *
             -/
  26          void t0_isr(void) interrupt 1 using 1
  27          {
  28   1          P1 = 0xFF;
  29   1          digi = (digi + 1) & 3;
  30   1          P0 = dbuf[digi];
  31   1          P1 = dsel[digi];
  32   1      }
  33          
  34          static unsigned char getc_(void) { while (!RI) ; RI = 0; return SBUF; }
  35          static void putc_(unsigned char c) { SBUF = c; while (!TI) ; TI = 0; }
  36          static void puthex(unsigned char v) { putc_(hexd[v >> 4]); putc_(hexd[v & 15]); }
  37          static void puts_(char code *s) { while (*s) putc_(*s++); }
  38          
  39          void main(void)
  40          {
  41   1          unsigned char i, j, k, best;
  42   1          int a;
  43   1          long s;
  44   1          unsigned long u;
  45   1      #ifdef TUNED
  46   1          signed char code *w;
  47   1          int idata *p;
  48   1          signed char wv;
  49   1          unsigned char hv, m;
  50   1      #endif
  51   1      
  52   1          dbuf[0] = dbuf[1] = 0xAB;      /* "nn--" until the first digit arrives */
C51 COMPILER V9.60.7.0   T                                                                 11/07/2026 17:47:46 PAGE 2   

  53   1          dbuf[2] = dbuf[3] = 0xBF;
  54   1          digi = 0;
  55   1          TMOD = 0x22;                   /* Timer 1: baud rate, Timer 0: display, both 8-bit auto-reload */
  56   1          TH1 = TL1 = 0xFD;
  57   1          PCON |= 0x80;                  /* SMOD = 1: 19200 baud */
  58   1          SCON = 0x50;
  59   1          TH0 = TL0 = 0;
  60   1          TR1 = 1; TR0 = 1; ET0 = 1; EA = 1;
  61   1          puts_("NN READY\r\n");
  62   1      
  63   1          for (;;) {
  64   2              while (getc_() != 'D') ;
  65   2              for (i = 0; i < 35; i++) pix[i] = (getc_() == '1');
  66   2      
  67   2              /* layer 1: bias, plus the weights of every lit square */
  68   2              for (j = 0; j < NH; j++) acc[j] = B1[j];
  69   2      #ifdef TUNED
  70   2              /* walk the table with a pointer instead of indexing W1[i][j] (which multiplies i by NH every time
             -) */
  71   2              w = &W1[0][0];
  72   2              for (i = 0; i < 35; i++, w += NH)
  73   2                  if (pix[i]) {
  74   3                      p = acc;
  75   3                      for (j = 0; j < NH; j++) *p++ += w[j];
  76   3                  }
  77   2      #else
                      for (i = 0; i < 35; i++)
                          if (pix[i])
                              for (j = 0; j < NH; j++) acc[j] += W1[i][j];
              #endif
  82   2              /* ReLU, then >> SH1, at most 255 */
  83   2              for (j = 0; j < NH; j++) {
  84   3                  a = acc[j];
  85   3                  if (a < 0) hid[j] = 0;
  86   3                  else { a >>= SH1; hid[j] = a > 255 ? 255 : (unsigned char)a; }
  87   3              }
  88   2      
  89   2              /* layer 2: bias plus hidden * weight */
  90   2              for (k = 0; k < 10; k++) {
  91   3                  s = B2[k];
  92   3      #ifdef TUNED
  93   3                  /* unsigned char * unsigned char lets C51 use MUL AB; the sign of the weight is handled by han
             -d */
  94   3                  w = W2[k];
  95   3                  for (j = 0; j < NH; j++) {
  96   4                      wv = w[j];
  97   4                      hv = hid[j];
  98   4                      if (wv < 0) { m = -wv; s -= (unsigned int)(hv * m); }
  99   4                      else { m = wv; s += (unsigned int)(hv * m); }
 100   4                  }
 101   3      #else
                          for (j = 0; j < NH; j++)
              #ifdef LONGMUL
                              s += (long)hid[j] * W2[k][j];
              #else
                              s += (int)hid[j] * W2[k][j];
              #endif
              #endif
 109   3                  score[k] = s;
 110   3              }
 111   2      
 112   2              /* the largest score is the answer */
C51 COMPILER V9.60.7.0   T                                                                 11/07/2026 17:47:46 PAGE 3   

 113   2              best = 0;
 114   2              for (k = 1; k < 10; k++) if (score[k] > score[best]) best = k;
 115   2      
 116   2              dbuf[2] = 0xFF;
 117   2              dbuf[3] = segs[best];
 118   2              putc_('=');
 119   2              putc_('0' + best);
 120   2              for (k = 0; k < 10; k++) {
 121   3                  u = (unsigned long)score[k];
 122   3                  putc_(' ');
 123   3                  puthex((unsigned char)(u >> 16));
 124   3                  puthex((unsigned char)(u >> 8));
 125   3                  puthex((unsigned char)u);
 126   3              }
 127   2              putc_('\r');
 128   2              putc_('\n');
 129   2          }
 130   1      }
