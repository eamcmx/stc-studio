; SWEEP BUILD (nn/study.py), H = 32. Digit reader on the UCI handwritten digits (8 x 8, squares on or off): a 64-24-10 neural network on the STC89C52RC.
; Made by nn/train_uci.py from ref/nn/digit_nn.a51 (same code, 64 inputs, new memory map). Do not edit by hand.
; The page sends D and 64 characters (1 for a dark square, 0 for a light one), row by row from the top left; the board answers "=", the
; digit and its 10 scores in hex, and shows the digit. Serial: 19200 baud. Board: as in digit_nn.a51.

PIX     EQU     30H             ; NIN bytes: the pixels                    (30H-6FH)
ACC1    EQU     70H             ; NH x 16-bit sums of the hidden layer    (70H-9FH)
HID     EQU     ACC1+2*NH       ; NH hidden values, 0 to 255               (A0H-B7H; above 7FH only @R0/@R1 reach)
SCORE   EQU     HID+NH          ; 10 x 24-bit scores, low byte first       (B8H-D5H)
DBUF    EQU     2CH             ; 4 segment patterns, digit 1 to digit 4
DIGI    EQU     2BH             ; the digit the display is showing now (0-3)

        ORG     0000H
        LJMP    MAIN
        ORG     000BH
        LJMP    T0ISR

        ORG     0030H
MAIN:   MOV     SP,#0EDH        ; stack from D8H, in the upper 128 bytes of the 8052's RAM
        MOV     DBUF,#0ABH      ; "nn--" until the first digit arrives
        MOV     DBUF+1,#0ABH
        MOV     DBUF+2,#0BFH
        MOV     DBUF+3,#0BFH
        MOV     DIGI,#0
        MOV     TMOD,#22H       ; Timer 1: baud rate, Timer 0: display, both 8-bit auto-reload
        MOV     TH1,#0FDH
        MOV     TL1,#0FDH
        ORL     PCON,#80H       ; SMOD = 1: 19200 baud
        MOV     SCON,#50H       ; mode 1, receiver on
        MOV     TH0,#0          ; Timer 0 overflows every 256 machine cycles
        MOV     TL0,#0
        SETB    TR1
        SETB    TR0
        SETB    ET0
        SETB    EA
        MOV     DPTR,#HELLO
        ACALL   PUTS

; ---- wait for D, then read 35 pixels
WAITD:  ACALL   GETC
        CJNE    A,#'D',WAITD
        MOV     R0,#PIX
        MOV     R2,#NIN
RDPIX:  ACALL   GETC
        CJNE    A,#'1',DARK
        MOV     @R0,#1
        SJMP    NEXTPX
DARK:   MOV     @R0,#0
NEXTPX: INC     R0
        DJNZ    R2,RDPIX

; ---- layer 1: start every sum at its bias
        MOV     DPTR,#B1
        MOV     R0,#ACC1
        MOV     R2,#2*NH
L1B:    CLR     A
        MOVC    A,@A+DPTR
        MOV     @R0,A
        INC     DPTR
        INC     R0
        DJNZ    R2,L1B
; for every lit pixel, add its row of NH weights to the NH sums
        MOV     DPTR,#W1
        MOV     R1,#PIX
        MOV     R3,#NIN
L1P:    MOV     A,@R1
        JZ      L1NEXT
        MOV     R0,#ACC1
        MOV     R4,#0
L1J:    MOV     A,R4
        MOVC    A,@A+DPTR       ; the weight, -128 to 127
        MOV     R5,A
        ADD     A,@R0           ; low byte of the sum
        MOV     @R0,A
        INC     R0
        MOV     A,R5
        JB      ACC.7,L1NEG
        CLR     A               ; a positive weight adds 00H to the high byte, with the carry
        SJMP    L1HI
L1NEG:  MOV     A,#0FFH         ; a negative one adds FFH
L1HI:   ADDC    A,@R0
        MOV     @R0,A
        INC     R0
        INC     R4
        CJNE    R4,#NH,L1J
L1NEXT: MOV     A,DPL           ; on to the next pixel's row
        ADD     A,#NH
        MOV     DPL,A
        JNC     L1N2
        INC     DPH
L1N2:   INC     R1
        DJNZ    R3,L1P

; ---- ReLU and scaling: hidden = 0 for a negative sum, else sum >> SH1, at most 255
        MOV     R0,#ACC1
        MOV     R1,#HID
        MOV     R2,#NH
RL1:    MOV     A,@R0
        MOV     R6,A            ; low byte
        INC     R0
        MOV     A,@R0
        MOV     R7,A            ; high byte
        INC     R0
        JB      ACC.7,RZERO
        MOV     R5,#SH1
RSH:    MOV     A,R5
        JZ      RSAT
        CLR     C
        MOV     A,R7
        RRC     A
        MOV     R7,A
        MOV     A,R6
        RRC     A
        MOV     R6,A
        DEC     R5
        SJMP    RSH
RSAT:   MOV     A,R7
        JZ      RLOW
        MOV     A,#0FFH         ; too big for a byte: 255
        SJMP    RSTORE
RLOW:   MOV     A,R6
        SJMP    RSTORE
RZERO:  CLR     A
RSTORE: MOV     @R1,A
        INC     R1
        DJNZ    R2,RL1

; ---- layer 2: score k = bias + sum of hidden j * weight, 24 bits in R7:R6:R5
        MOV     DPTR,#W2        ; each row: 3 bytes of bias, then NH weights
        MOV     R1,#SCORE
        MOV     R3,#10
L2K:    CLR     A
        MOVC    A,@A+DPTR
        MOV     R5,A
        MOV     A,#1
        MOVC    A,@A+DPTR
        MOV     R6,A
        MOV     A,#2
        MOVC    A,@A+DPTR
        MOV     R7,A
        MOV     R0,#HID
        MOV     R2,#3
L2J:    MOV     A,R2
        MOVC    A,@A+DPTR       ; the weight
        JB      ACC.7,L2NEG
        MOV     B,@R0
        MUL     AB              ; hidden * weight: B = high byte, A = low byte
        ADD     A,R5
        MOV     R5,A
        MOV     A,B
        ADDC    A,R6
        MOV     R6,A
        CLR     A
        ADDC    A,R7
        MOV     R7,A
        SJMP    L2NEXT
L2NEG:  CPL     A               ; a negative weight: multiply by its size and subtract
        INC     A
        MOV     B,@R0
        MUL     AB
        XCH     A,R5            ; A = the score's low byte, R5 = the product's low byte
        CLR     C
        SUBB    A,R5
        MOV     R5,A
        MOV     A,R6
        SUBB    A,B
        MOV     R6,A
        MOV     A,R7
        SUBB    A,#0
        MOV     R7,A
L2NEXT: INC     R0
        INC     R2
        CJNE    R2,#NH+3,L2J
        MOV     A,R5            ; keep the score
        MOV     @R1,A
        INC     R1
        MOV     A,R6
        MOV     @R1,A
        INC     R1
        MOV     A,R7
        MOV     @R1,A
        INC     R1
        MOV     A,DPL           ; on to the next digit's row
        ADD     A,#NH+3
        MOV     DPL,A
        JNC     L2N2
        INC     DPH
L2N2:   DJNZ    R3,L2K

; ---- the largest score: compare with the sign bit flipped, so that unsigned order is signed order
        MOV     R1,#SCORE
        MOV     A,@R1
        MOV     R5,A
        INC     R1
        MOV     A,@R1
        MOV     R6,A
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     R7,A            ; R7:R6:R5 = the best so far
        INC     R1
        MOV     R4,#0           ; its digit
        MOV     R3,#1
AMAX:   CLR     C               ; best - score: a borrow means this score is larger
        MOV     A,R5
        SUBB    A,@R1
        INC     R1
        MOV     A,R6
        SUBB    A,@R1
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     B,A
        MOV     A,R7
        SUBB    A,B
        JNC     AMNEXT
        DEC     R1              ; a new best
        DEC     R1
        MOV     A,@R1
        MOV     R5,A
        INC     R1
        MOV     A,@R1
        MOV     R6,A
        INC     R1
        MOV     A,@R1
        XRL     A,#80H
        MOV     R7,A
        MOV     A,R3
        MOV     R4,A
AMNEXT: INC     R1
        INC     R3
        CJNE    R3,#10,AMAX

; ---- show it ("nn 7") and send "=7" and the 10 scores
        MOV     A,R4
        MOV     DPTR,#SEGS
        MOVC    A,@A+DPTR
        MOV     DBUF+3,A
        MOV     DBUF+2,#0FFH
        MOV     A,#'='
        ACALL   PUTC
        MOV     A,R4
        ADD     A,#'0'
        ACALL   PUTC
        MOV     R1,#SCORE+2     ; the high byte of score 0
        MOV     R3,#10
SEND:   MOV     A,#' '
        ACALL   PUTC
        MOV     A,@R1
        ACALL   PUTHEX
        DEC     R1
        MOV     A,@R1
        ACALL   PUTHEX
        DEC     R1
        MOV     A,@R1
        ACALL   PUTHEX
        MOV     A,R1
        ADD     A,#5            ; the high byte of the next score
        MOV     R1,A
        DJNZ    R3,SEND
        MOV     A,#13
        ACALL   PUTC
        MOV     A,#10
        ACALL   PUTC
        LJMP    WAITD

; ---- serial port
GETC:   JNB     RI,GETC
        MOV     A,SBUF
        CLR     RI
        RET
PUTC:   MOV     SBUF,A
        JNB     TI,$
        CLR     TI
        RET
PUTHEX: PUSH    ACC             ; two hex characters for A
        SWAP    A
        ACALL   NIBBLE
        POP     ACC
NIBBLE: ANL     A,#0FH
        CJNE    A,#10,NIB1
NIB1:   JC      NIB2            ; 0-9
        ADD     A,#7            ; A-F
NIB2:   ADD     A,#'0'
        ACALL   PUTC
        RET
PUTS:   CLR     A               ; the text at DPTR, up to a 0 byte
        MOVC    A,@A+DPTR
        JZ      PUTS9
        ACALL   PUTC
        INC     DPTR
        SJMP    PUTS
PUTS9:  RET

; ---- Timer 0, every 256 machine cycles: the next digit of the display (register bank 1)
T0ISR:  PUSH    PSW
        PUSH    ACC
        PUSH    DPL
        PUSH    DPH
        MOV     PSW,#08H
        MOV     P1,#0FFH        ; all digits off while the segments change
        MOV     A,DIGI
        INC     A
        ANL     A,#03H
        MOV     DIGI,A
        ADD     A,#DBUF
        MOV     R0,A
        MOV     P0,@R0
        MOV     A,DIGI
        MOV     DPTR,#DSEL
        MOVC    A,@A+DPTR
        MOV     P1,A
        POP     DPH
        POP     DPL
        POP     ACC
        POP     PSW
        RETI

DSEL:   DB      0F7H,0EFH,0DFH,0BFH            ; digit 1 to digit 4: P1.3 to P1.6 low
SEGS:   DB      0C0H,0F9H,0A4H,0B0H,99H,92H,82H,0F8H,80H,90H
HELLO:  DB      'NN READY',13,10,0

; ---- WEIGHTS (written by nn/train_uci.py)
NIN     EQU     64              ; inputs
NH      EQU     32              ; hidden neurons
SH1     EQU     1               ; hidden values are (sum >> SH1), 0 to 255

B1:
        DB      0FAH,0FFH,01FH,000H,0F9H,0FFH,006H,000H,0EDH,0FFH,0FCH,0FFH,0FCH,0FFH,009H,000H
        DB      020H,000H,0F8H,0FFH,00EH,000H,0FAH,0FFH,01EH,000H,0F9H,0FFH,00EH,000H,004H,000H
        DB      0FBH,0FFH,0F5H,0FFH,0FAH,0FFH,00AH,000H,0E4H,0FFH,0F5H,0FFH,023H,000H,0F9H,0FFH
        DB      010H,000H,0FBH,0FFH,0F7H,0FFH,0F5H,0FFH,0FCH,0FFH,008H,000H,0FAH,0FFH,0FCH,0FFH
W1:
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,0F5H,000H,022H,0C9H,000H,000H,00AH,022H,009H,020H,000H,026H,0E5H,03FH,0ECH
        DB      0F4H,000H,000H,0FEH,011H,015H,01BH,000H,007H,000H,0D7H,00FH,01BH,0F2H,000H,0FBH
        DB      000H,003H,000H,031H,0F2H,000H,000H,005H,023H,0EDH,015H,0FBH,004H,008H,013H,00AH
        DB      0FFH,000H,000H,00EH,0F1H,01BH,0F5H,000H,030H,000H,0E4H,016H,016H,01CH,000H,003H
        DB      000H,001H,000H,0EFH,0F7H,000H,000H,008H,004H,004H,025H,0E5H,022H,0EBH,0F4H,01CH
        DB      003H,0FFH,000H,00BH,0F9H,0CDH,01CH,000H,00BH,000H,0ECH,034H,0FCH,0F7H,000H,00DH
        DB      000H,0EBH,000H,0FAH,008H,000H,000H,0F1H,03FH,0CEH,032H,0D5H,0F3H,0DAH,009H,0E5H
        DB      0D7H,000H,000H,017H,0E8H,0F0H,00BH,000H,042H,000H,0D8H,034H,0FBH,0EFH,000H,005H
        DB      000H,00CH,000H,0FBH,0FCH,000H,000H,0F9H,014H,0F9H,019H,01BH,023H,0DEH,0FEH,0F0H
        DB      0F9H,000H,000H,001H,0E6H,0F5H,010H,000H,022H,000H,0C9H,021H,0E2H,0F6H,000H,004H
        DB      000H,018H,000H,0FFH,0EFH,000H,000H,0FEH,0FEH,000H,009H,004H,024H,000H,004H,0EFH
        DB      0FFH,000H,000H,00DH,0EEH,000H,013H,000H,0F4H,000H,000H,0F3H,007H,0F2H,000H,010H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,0F3H,000H,00FH,0DFH,000H,000H,003H,015H,05CH,02BH,0EBH,0E4H,007H,0E9H,0FCH
        DB      0F7H,000H,000H,0EFH,0DFH,016H,009H,000H,022H,000H,0CAH,0DFH,014H,00CH,000H,015H
        DB      000H,0FFH,000H,021H,0F2H,000H,000H,020H,022H,0F5H,01BH,025H,0FEH,0F8H,035H,0FCH
        DB      0FCH,000H,000H,0E7H,0FCH,013H,0E8H,000H,025H,000H,0DEH,0F8H,0D6H,009H,000H,0CBH
        DB      000H,024H,000H,00AH,0E8H,000H,000H,019H,02EH,0EFH,0EBH,019H,03EH,0FFH,005H,001H
        DB      00DH,000H,000H,004H,0F4H,001H,009H,000H,022H,000H,0D4H,012H,0EBH,00EH,000H,008H
        DB      000H,0FDH,000H,010H,000H,000H,000H,004H,00BH,00AH,0FEH,008H,0D8H,008H,0FFH,03FH
        DB      0C4H,0FFH,000H,013H,0EFH,0F1H,00FH,000H,03EH,000H,0F4H,00BH,0EEH,0D3H,000H,0D7H
        DB      000H,00AH,000H,00EH,0FBH,000H,000H,018H,021H,0E0H,019H,0F7H,0CEH,00FH,007H,012H
        DB      0E1H,000H,000H,01AH,005H,002H,006H,000H,01BH,000H,005H,023H,0F6H,0F4H,000H,0DEH
        DB      000H,02AH,000H,0DFH,008H,000H,000H,0F9H,006H,0F0H,0F9H,010H,0F8H,0E6H,006H,016H
        DB      030H,000H,000H,002H,0FFH,013H,00FH,000H,0E7H,000H,012H,0F8H,00EH,0F4H,000H,006H
        DB      000H,0FCH,000H,0FCH,0F7H,000H,000H,0FEH,001H,000H,015H,008H,0E7H,001H,000H,004H
        DB      0FCH,000H,000H,005H,009H,0FDH,009H,000H,003H,000H,0DDH,01AH,009H,003H,000H,0FFH
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,0FBH,000H,0FEH,003H,000H,000H,029H,0F1H,0E1H,003H,005H,0B1H,004H,0F1H,002H
        DB      0EAH,000H,000H,0E5H,018H,02CH,0FDH,000H,011H,000H,00BH,003H,0FCH,0F1H,000H,0F7H
        DB      000H,0E3H,000H,0BAH,01EH,000H,000H,0F9H,0EEH,0E0H,02AH,010H,025H,017H,01DH,0E8H
        DB      013H,0FFH,000H,02EH,004H,058H,0F2H,000H,0EEH,000H,032H,016H,0F2H,058H,000H,0E6H
        DB      000H,01EH,000H,0A6H,00AH,000H,000H,02EH,0CCH,026H,0E7H,001H,054H,0EDH,022H,0FDH
        DB      0FFH,000H,000H,04FH,03DH,0C5H,012H,000H,0BAH,000H,031H,024H,0EAH,023H,000H,008H
        DB      000H,001H,000H,011H,019H,000H,000H,027H,0DBH,020H,0DEH,0D6H,0D0H,0F1H,02EH,050H
        DB      0A4H,0FFH,000H,0EBH,048H,0F6H,030H,000H,0F0H,000H,009H,030H,00AH,0FBH,000H,0E8H
        DB      000H,0F3H,000H,02FH,0F9H,000H,000H,005H,0DDH,0A9H,0B7H,018H,0B8H,05CH,00CH,026H
        DB      051H,000H,000H,012H,001H,04AH,008H,000H,016H,000H,001H,0F7H,0C5H,024H,000H,0DCH
        DB      000H,014H,000H,013H,00FH,000H,000H,004H,0F7H,00EH,0DDH,0E3H,0CAH,012H,0F2H,00FH
        DB      014H,000H,000H,006H,00AH,0F3H,0FEH,000H,00BH,000H,0F7H,012H,0E6H,010H,000H,0D8H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,0EFH,000H,0DCH,00FH,000H,000H,0F6H,028H,0DAH,0F3H,0CCH,02AH,002H,000H,0DBH
        DB      010H,000H,000H,0F9H,0FDH,0E3H,0EFH,000H,002H,000H,01EH,00AH,0EDH,00EH,000H,0E1H
        DB      000H,0C7H,000H,0DBH,009H,000H,000H,0F4H,006H,007H,014H,016H,02DH,004H,0B6H,0E3H
        DB      0E1H,000H,000H,02BH,0F1H,066H,0FDH,000H,0E9H,000H,01AH,020H,012H,01EH,000H,0F4H
        DB      000H,00AH,000H,0EDH,0D4H,000H,000H,0F9H,0D2H,007H,032H,0ECH,009H,0F4H,013H,026H
        DB      00FH,000H,000H,01BH,002H,017H,0EDH,000H,0D1H,000H,026H,029H,03BH,013H,000H,011H
        DB      000H,019H,000H,0E8H,02AH,000H,000H,0FAH,004H,0BDH,00CH,0D9H,0E9H,003H,0F2H,04AH
        DB      024H,000H,000H,0EBH,003H,00CH,014H,000H,009H,000H,010H,0F9H,032H,0F0H,000H,000H
        DB      000H,00EH,000H,005H,0EBH,000H,000H,0F1H,0F8H,0D6H,0FFH,0DDH,0F1H,014H,0BAH,017H
        DB      056H,000H,000H,021H,007H,012H,010H,000H,0E2H,000H,014H,0DBH,0DDH,02DH,000H,0F6H
        DB      000H,01FH,000H,015H,0E1H,000H,000H,0BCH,0EFH,006H,0D2H,01EH,0E9H,02BH,0EFH,0E6H
        DB      010H,000H,000H,01FH,0B6H,0FDH,027H,000H,001H,000H,0F9H,0AEH,0F1H,008H,000H,0E5H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H,000H
        DB      000H,006H,000H,0F0H,0F1H,000H,000H,0EFH,012H,010H,016H,029H,01FH,005H,0F8H,003H
        DB      0F0H,000H,000H,003H,0FDH,0F4H,036H,000H,0EAH,000H,00EH,0E7H,00EH,0DAH,000H,0FCH
        DB      000H,0EDH,000H,0F5H,0E9H,000H,000H,0DEH,02BH,01BH,0B7H,021H,00BH,03CH,014H,030H
