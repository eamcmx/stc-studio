LOC  OBJ            LINE     SOURCE

                       1     ;=======================================================================
                       2     ; STC89C52RC board demo: four games with sound and light
                       3     ;
                       4     ; Power on: a light runs along the LEDs while the buzzer slides up and
                       5     ; down, the display scrolls HELLO to a short tune, then the menu shows
                       6     ;
                       7     ;       P   E   5   r        (one letter above each button)
                       8     ;      S5  S4  S3  S2
                       9     ;
                      10     ;   S5  P  Binary piano  the four buttons are the bits 8 4 2 1 of a
                      11     ;                        number; the display shows the bits, the
                      12     ;                        buzzer plays note number 1..15 of the scale
                      13     ;   S4  E  Echo          the board plays a growing tune of four notes,
                      14     ;                        you play it back (memory game, 20 rounds)
                      15     ;   S3  5  Song          Ode to Joy, the LEDs bounce with the music
                      16     ;   S2  r  Reaction      wait for Go, press any button, the display
                      17     ;                        shows your reaction time in milliseconds
                      18     ;
                      19     ; Leave the menu alone for 12 s and the board plays the song by itself.
                      20     ;
                      21     ; Board wiring (TSI STC89C52RC board):
                      22     ;   P0.0-P0.7  segments a-g, dp (lit by 0) and LEDs D1-D8 (lit by 0)
                      23     ;   P1.3-P1.6  digit enables, left to right (digit on at 0)
                      24     ;   P3.5-P3.2  buttons S5, S4, S3, S2 (a pressed button reads 0)
                      25     ;   P3.6       buzzer LS1 (it sounds while the pin toggles)
                      26     ; Clock 11.0592 MHz, 12 clocks per machine cycle: 1 cycle = 1.085 us
                      27     ;
                      28     ; How it works:
                      29     ;   Timer 0 (high priority) flips P3.6 every half period of the note.
                      30     ;   Timer 1 interrupts every 1 ms. It lights one digit per interrupt
                      31     ;   (all four every 4 ms), counts milliseconds, runs the wait timer
                      32     ;   and plays tunes in the background, so the main program can scroll
                      33     ;   text or move lights while music plays.
                      34     ;=======================================================================
                      35     
                      36     ;--------------------------- RAM ---------------------------------------
                      37     ; bit flags in 20H
  0000                38     LEDMODE BIT     00H             ; 1: digits off, P0 shows LEDPAT on the LEDs
  0001                39     PLAYING BIT     01H             ; 1: Timer 1 is playing a tune
  0002                40     LEGATO  BIT     02H             ; 1: this note runs into the next (no gap)
  0003                41     DLYRUN  BIT     03H             ; 1: the millisecond wait timer is running
  0004                42     NZFLAG  BIT     04H             ; used by SHOWDEC to blank leading zeros
                      43     
  0030                44     DISP    EQU     30H             ; 30H-33H segment codes of digits 1-4
  0034                45     LEDPAT  EQU     34H             ; LED pattern for LEDMODE (0 = LED on)
  0035                46     NOTEH   EQU     35H             ; Timer 0 reload for the note now playing
  0036                47     NOTEL   EQU     36H
  0037                48     TICKL   EQU     37H             ; milliseconds since power on (16 bits)
  0038                49     TICKH   EQU     38H
  0039                50     DLYL    EQU     39H             ; wait timer, counts down in ms
  003A                51     DLYH    EQU     3AH
  003B                52     SONGL   EQU     3BH             ; where the tune player is in the tune
  003C                53     SONGH   EQU     3CH
  003D                54     PRE     EQU     3DH             ; 10 ms prescaler for the tune player
  003E                55     NOTECNT EQU     3EH             ; 10 ms steps left of the current note
  003F                56     CURNOTE EQU     3FH             ; note sounding now (0 = silence)
  0040                57     RND     EQU     40H             ; random number generator state
  0041                58     LEN     EQU     41H             ; Echo: length of the tune
A51 MACRO ASSEMBLER  T                                                                    11/07/2026 13:34:11 PAGE     2

  0042                59     CNT     EQU     42H             ; Echo: notes left to play or check
  0043                60     PADV    EQU     43H             ; Echo: button the player pressed
  0044                61     PN      EQU     44H             ; Piano: number held on the buttons
  0045                62     LEVEL   EQU     45H             ; Song: height of the LED bar
  0046                63     TSTL    EQU     46H             ; Reaction: time of Go (16 bits)
  0047                64     TSTH    EQU     47H
  0048                65     SEQ     EQU     48H             ; Echo: the tune, 48H-5BH (20 steps)
  0014                66     MAXLEN  EQU     20
                      67     ; stack 60H-7FH (SP starts at 5FH)
                      68     
  00B6                69     BUZ     BIT     P3.6
