LOC  OBJ            LINE     SOURCE

                       1     ;=======================================================================
                       2     ; STC89C52RC board demo 2: light and games, without a sound
                       3     ;
                       4     ; Power on: a light with a fading tail runs up and down the LEDs, all
                       5     ; eight LEDs breathe once, a snake runs round the edge of the display,
                       6     ; HELLO AGAIN scrolls past, then the names of the four modes, and the
                       7     ; menu stays on the display with one letter above each button:
                       8     ;
                       9     ;       C   r   L   P
                      10     ;      S5  S4  S3  S2
                      11     ;
                      12     ;   S5  C  Chrono   stopwatch in hundredths of a second. S5 starts and
                      13     ;                   stops it, S4 freezes the display while it runs
                      14     ;                   (a split time) or sets it to zero when stopped,
                      15     ;                   S2 goes back to the menu
                      16     ;   S4  r  Race     three lanes: the top, middle and bottom segments.
                      17     ;                   Your car blinks on the left digit, the other cars
                      18     ;                   come from the right. S5 steers up, S4 down. Every
                      19     ;                   car you pass makes the road a little faster
                      20     ;   S3  L  Lights   five LED effects with 16 brightness levels: comet,
                      21     ;                   breathing, stars, wave, bouncing ball. S3 shows the
                      22     ;                   next effect, any other button goes to the menu
                      23     ;   S2  P  Pong     for two players. The ball runs along the LEDs; S5
                      24     ;                   hits it back when it is on D1, S2 when it is on D8.
                      25     ;                   First to 5 points
                      26     ;
                      27     ; Leave the menu alone for 12 s and the light show runs once by itself,
                      28     ; then the menu comes back: the board can run unattended on a desk.
                      29     ;
                      30     ; Board wiring (TSI STC89C52RC board):
                      31     ;   P0.0-P0.7  segments a-g, dp (lit by 0) and LEDs D1-D8 (lit by 0)
                      32     ;   P1.3-P1.6  digit enables, left to right (digit on at 0)
                      33     ;   P3.5-P3.2  buttons S5, S4, S3, S2 (a pressed button reads 0)
                      34     ;   P3.6       buzzer: this program never touches it
                      35     ; Clock 11.0592 MHz, 12 clocks per machine cycle: 921 600 cycles a second
                      36     ;
                      37     ; How it works:
                      38     ;   Timer 2, the third timer of the 8052, reloads itself in hardware
                      39     ;   every 1152 cycles, which is exactly 1.25 ms. Its interrupt lights
                      40     ;   the next digit, and every eighth one (10 ms) marks a new frame for
                      41     ;   the main program and counts the stopwatch.
                      42     ;   Timer 0 makes the LED brightness. In LED mode it switches P0
                      43     ;   between five bit patterns that last 1, 2, 4, 8 and 16 time units
                      44     ;   (binary code modulation), so each LED can be lit for 0 to 31 of
                      45     ;   the 31 units, about 620 times a second.
                      46     ;   The LEDs and the segments share P0, so the board shows either the
                      47     ;   digits or the LEDs, never both at once.
                      48     ;=======================================================================
                      49     
                      50     ; the 8052's Timer 2 registers (A51 knows only the 8051 ones)
  00C8                51     T2CON   DATA    0C8H
  00CA                52     RCAP2L  DATA    0CAH
  00CB                53     RCAP2H  DATA    0CBH
  00CC                54     TL2     DATA    0CCH
  00CD                55     TH2     DATA    0CDH
  00CF                56     TF2     BIT     0CFH            ; T2CON.7: Timer 2 overflowed
  00CA                57     TR2     BIT     0CAH            ; T2CON.2: Timer 2 runs
  00AD                58     ET2     BIT     0ADH            ; IE.5: Timer 2 interrupt enable
A51 MACRO ASSEMBLER  T                                                                    11/07/2026 13:34:12 PAGE     2

                      59     
                      60     ;--------------------------- RAM ---------------------------------------
                      61     ; 08H-0FH  register bank 1, used by the Timer 2 interrupt
                      62     ;          (R0 pointer, R6 ticks left in the frame, R7 digit 0-3)
                      63     ; 10H-17H  register bank 2, used by the Timer 0 interrupt
                      64     ;          (R0 the next PWM slot, R7 slots left in the PWM frame)
                      65     ; bit flags in 20H
  0000                66     LEDMODE BIT     00H             ; 1: digits off, Timer 0 drives the LEDs
  0001                67     FRAME   BIT     01H             ; set by Timer 2 every 10 ms
  0002                68     SWRUN   BIT     02H             ; 1: the stopwatch is counting
  0003                69     SPLIT   BIT     03H             ; 1: the stopwatch display is frozen
  0004                70     NZFLAG  BIT     04H             ; used by SHOWDEC to blank leading zeros
  0005                71     ATTRACT BIT     05H             ; 1: nobody chose the light show, play one round
                      72     
  0021                73     FRL     EQU     21H             ; 10 ms frames since power on (16 bits)
  0022                74     FRH     EQU     22H
  0023                75     SWC     EQU     23H             ; stopwatch: hundredths, packed BCD 00-99
  0024                76     SWS     EQU     24H             ;            seconds, packed BCD 00-59
  0025                77     SWM     EQU     25H             ;            minutes 0-9
  0026                78     LPC     EQU     26H             ; the time on the display (a copy)
  0027                79     LPS     EQU     27H
  0028                80     LPM     EQU     28H
  0029                81     KRAW    EQU     29H             ; the buttons at the last look
  002A                82     KDEB    EQU     2AH             ; the buttons after debouncing
  002B                83     KTMP    EQU     2BH
  002C                84     RND     EQU     2CH             ; random number generator state
  002D                85     EFF     EQU     2DH             ; the light effect now running, 0-4
  002E                86     FXT     EQU     2EH             ; 20 ms frames since the effect started
  002F                87     BEST    EQU     2FH             ; Race: best score since power on
  0030                88     DISP    EQU     30H             ; 30H-33H segment codes of digits 1-4
  0034                89     BRI     EQU     34H             ; 34H-3BH brightness of D1-D8, 0-15
  003C                90     PB      EQU     3CH             ; 3CH-40H the five bit patterns being built
  0041                91     SL      EQU     41H             ; 41H-52H nine PWM slots: P0 pattern, next TH0
  0053                92     POS     EQU     53H             ; Lights, Pong: an LED, 0 (D1) to 7 (D8)
  0054                93     DIRN    EQU     54H             ;   its direction: 0 towards D8, 1 towards D1
  0055                94     BY      EQU     55H             ; Lights: ball height in 1/32 of an LED
  0056                95     BV      EQU     56H             ;   ball speed in 1/32 LED per frame (signed)
  0057                96     STEPT   EQU     57H             ; Race, Pong: 10 ms frames per step
  0058                97     STEPC   EQU     58H             ;   frames left in this step
  0059                98     LANE    EQU     59H             ; Race: your lane, 0 top, 1 middle, 2 bottom
  005A                99     SCORE   EQU     5AH             ;   cars passed
  005B               100     GAP     EQU     5BH             ;   empty digits before the next car
  005A               101     SCL     EQU     5AH             ; Pong: points of the D1 player (SCORE)
  005B               102     SCR     EQU     5BH             ;   points of the D8 player (GAP)
  005C               103     ROAD    EQU     5CH             ; Race: 5CH-5FH lanes taken in digits 1-4
                     104     ; stack 60H-7FH (SP starts at 5FH)
                     105     
