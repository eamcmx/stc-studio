0015 08              152             INC     R0
0016 DF04            153             DJNZ    R7,T0_X
0018 7841            154             MOV     R0,#SL          ; all nine slots done: the frame starts again
001A 7F09            155             MOV     R7,#9
001C D0D0            156     T0_X:   POP     PSW
001E 32              157             RETI
                     158     
002B                 159             ORG     002BH           ; Timer 2: every 1.25 ms
