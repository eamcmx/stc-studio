 DSEG AT 40H
CNT: DS 1
BUF: DS 4
 BSEG AT 10H
F1: DBIT 1
F2: DBIT 3
F3: DBIT 1
 ISEG AT 80H
STK: DS 10H
 XSEG AT 1000H
XB: DS 10
 CSEG AT 0
 MOV CNT,#1
 MOV R0,#BUF
 SETB F3
 MOV A,STK
 MOV R0,#STK
 MOV DPTR,#XB
 MOV A,XB
 DB CNT, BUF, F1, F2, F3
 DSEG
NEXT: DS 1
 CSEG
 MOV A,NEXT
 DSEG AT 7FH
BIG: DS 2
 CSEG
 MOV A,BIG+1
 DB 1
 DSEG
 DB 5
 END
