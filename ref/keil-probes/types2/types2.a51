 ORG 0
L1: NOP
D1 DATA 30H
B1 BIT 20H.1
 MOV A,1+D1
 MOV A,D1+D1
 MOV A,LOW D1
 MOV A,D1 AND 0FFH
 MOV A,D1 SHL 0
 MOV A,HIGH D1
 LJMP L1 OR 0
 LJMP 1+L1
 MOV A,L1-D1
 MOV A,D1*1
 MOV A,-D1
 LJMP L1-1
 MOV A,(D1)
 SETB B1+1
 SETB 1+B1
D2 EQU D1
 MOV A,D2
D3 DATA L1
 MOV A,D3
B2 BIT D1.1
B3 BIT B1
 SETB B3
B4 BIT 30H
B5 DATA B1
N2 EQU L1
 MOV A,N2
 LJMP N2
N3 SET D1
 MOV A,N3
 LJMP D1+L1
 MOV A,D1-1
 MOV A,D1/1
 LJMP L1+L1
 LJMP L1*1
 LJMP HIGH L1
 MOV A,30H+D1-D1
 SETB B1-B1
 SETB B1-1
 SJMP L1+1
 SJMP 1+L1
 MOV A,D1 EQ D1
 LJMP L1 EQ L1
 MOV A,NOT D1
 DB D1+L1
 MOV R0,#D1+L1
 MOV A,L1 SHR 1
 JB B1+D1,$
 JB D1.0+1,$
B6 BIT 7FH
B7 BIT 80H
B8 BIT 0FFH
B9 BIT 100H
D4 DATA 100H
D5 DATA 0FFH
X2 XDATA 10000H
C2 CODE 0FFFFH
 MOV A,D4
 END
