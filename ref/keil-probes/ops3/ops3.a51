 ORG 0
 LJMP B1
 LCALL D1
 ACALL D1
 SJMP B1
 JB L1,$
 JB B1,L1
 JB B1,D1
 DJNZ R0,D1
 CJNE A,#1,D1
 MOV C,D1
 MOV D1,C
 MOV C,#1
 MOV A,#1,
 MOV @R0,@R1
 MOV @DPTR,A
 MOVX A,@R2
 MOVX @R0,#1
 MOVC A,@A+R0
 MOVC A,@DPTR
 JMP @DPTR
 JMP @A+PC
 XCH A,#1
 XCH R0,A
 INC C
 CPL A,C
 SETB A
 MUL R0
 DIV A
 SWAP R0
 DA R0
 POP A
 ANL C,30H
 ANL C,/D1
 ORL C,#1
 MOV A,@R0+1
 MOV A,R0+1
 ADD A,@A+DPTR
 CJNE R0,30H,$
 CJNE @R0,30H,$
 DJNZ A,$
 DJNZ @R0,$
L1: NOP
D1 DATA 30H
B1 BIT 20H.0
 END
