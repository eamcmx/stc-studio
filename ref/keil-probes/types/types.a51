 ORG 0
L1: NOP
 MOV A,L1
 MOV DPTR,#L1
 SETB L1
 LJMP 30H
D1 DATA 30H
 LJMP D1
 MOV A,D1
B1 BIT 20H.1
 MOV A,B1
 JB D1,$
 MOV A,#D1
 MOV A,#B1
 MOV A,#L1
X1 XDATA 1000H
 MOV DPTR,#X1
 MOV A,X1
I1 IDATA 80H
 MOV R0,#I1
 MOV A,I1
C1 CODE 100H
 LJMP C1
 MOV A,C1
N1 EQU 40H
 LJMP N1
 MOV A,N1
 SETB N1
 MOV A,D1+1
 LJMP L1+1
 DB L1
 DW L1
 DB D1
 DB B1
 MOV A,L1-L1+30H
 MOV A,D1-D1
 LJMP D1-D1+L1
 MOV A,#HIGH(L1)
 MOV DPTR,#D1
 SJMP 2
 SJMP D1
 END
